# ---- Backend ----
# Copy this file to .env (backend/.env also works) and fill in values.

# Hindsight by Vectorize (agent memory). Leave blank to run in local fallback mode.
#   - Local:  HINDSIGHT_API_URL=http://localhost:8888
#   - Cloud:  https://api.hindsight.vectorize.io  (set HINDSIGHT_API_KEY)
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=contentmind

# LLM provider (OpenAI-compatible). Examples:
#   OpenAI:    LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
#   Groq:      LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
#   Together:  LLM_BASE_URL=https://api.together.xyz/v1   LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# SQLite for development (keep compatible with PostgreSQL in production)
DATABASE_URL=sqlite:///./contentmind.db

# FastAPI
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
